ANISP_SERVER_HOST=0.0.0.0
ANISP_SERVER_PORT=3000
RUST_LOG=info

ANISP_CLICKHOUSE_URL=http://127.0.0.1:8123
ANISP_CLICKHOUSE_DATABASE=anisp
ANISP_CLICKHOUSE_USER=anisp
ANISP_CLICKHOUSE_PASSWORD=anisp
ANISP_CLICKHOUSE_REQUEST_TIMEOUT_MS=3000

ANISP_POSTGRES_URL=postgres://anisp:anisp@127.0.0.1:5432/anisp
ANISP_POSTGRES_MAX_CONNECTIONS=10
ANISP_POSTGRES_REQUEST_TIMEOUT_MS=3000

ANISP_SUPPORT_OUTBOX_POLL_INTERVAL_MS=1000
ANISP_SUPPORT_OUTBOX_BATCH_SIZE=100
ANISP_SUPPORT_OUTBOX_CLAIM_LEASE_MS=30000
ANISP_SUPPORT_OUTBOX_MAX_ATTEMPTS=10

# Git outbox delivery only; this does not enable repository scanning.
ANISP_GIT_OUTBOX_POLL_INTERVAL_MS=1000
ANISP_GIT_OUTBOX_BATCH_SIZE=100
ANISP_GIT_OUTBOX_CLAIM_LEASE_MS=30000
ANISP_GIT_OUTBOX_MAX_ATTEMPTS=10

# SupportCase Git window is anchored to case.created_at, not the current time.
# Positive bounded values: lookback 1..720 hours, max commits 1..500.
ANISP_CONTEXT_GIT_LOOKBACK_HOURS=24
ANISP_CONTEXT_GIT_MAX_COMMITS=50
